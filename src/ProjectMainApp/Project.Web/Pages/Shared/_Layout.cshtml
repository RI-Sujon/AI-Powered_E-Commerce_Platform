@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Bazaar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <script>
        // Prevent dark mode flash — must run before body renders
        (function () {
            var saved = localStorage.getItem('darkMode') || 'light';
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_Header" />
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <partial name="_AssistantWidget" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.API_BASE_URL = '@Configuration["ApiBaseUrl"]';
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Components/toast.js"></script>
    <script src="~/js/Common.js"></script>
    <script src="~/js/Services/ServiceUtils.js"></script>
    <script src="~/js/Services/CategoryService.js"></script>
    <script src="~/js/Services/OrderService.js"></script>
    <script src="~/js/Services/AdminService.js"></script>
    <script src="~/js/Services/UserService.js"></script>
    <script src="~/js/Services/WishlistService.js"></script>
    <script src="~/js/Services/AiService.js"></script>
    <script src="~/js/Components/assistant-widget.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <footer class="site-footer">
        <div class="container px-md-5">
            <div class="row">
                <!-- Brand Column -->
                <div class="col-md-4 mb-4 mb-md-0">
                    <img src="/css/images/Original.png" height="32" alt="E-Bazaar">
                    <p class="mt-2 mb-2" style="font-family:var(--font-display);font-style:italic;letter-spacing:0.02em;color:rgba(255,255,255,0.6);font-size:0.9rem">
                        Curated excellence, delivered.
                    </p>
                    <p style="font-size:0.78rem;color:rgba(255,255,255,0.45);line-height:1.7;margin-bottom:0">
                        Bangladesh's trusted destination for premium products. Quality you can count on, service you'll love.
                    </p>
                </div>
                <!-- Quick Links -->
                <div class="col-md-2 col-6 mb-3 mb-md-0">
                    <h6 class="footer-heading">Shop</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/Product">All Products</a></li>
                        <li id="footer-orders" class="d-none"><a href="/Order">My Orders</a></li>
                        <li id="footer-profile" class="d-none"><a href="/Profile">My Account</a></li>
                        <li id="footer-admin" class="d-none"><a href="/Admin">Admin Panel</a></li>
                    </ul>
                </div>
                <!-- Company -->
                <div class="col-md-2 col-6 mb-3 mb-md-0">
                    <h6 class="footer-heading">Company</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/About">About Us</a></li>
                        <li><a href="/Contact">Contact</a></li>
                    </ul>
                </div>
                <!-- Contact Info -->
                <div class="col-md-4">
                    <h6 class="footer-heading">Get in Touch</h6>
                    <ul class="list-unstyled footer-links">
                        <li><i class="fas fa-map-marker-alt me-2" style="color:var(--accent);width:14px"></i>Dhaka, Bangladesh</li>
                        <li><i class="fas fa-phone me-2" style="color:var(--accent);width:14px"></i>+880 1712-345678</li>
                        <li><i class="fas fa-envelope me-2" style="color:var(--accent);width:14px"></i>support&#64;ebazaar.com.bd</li>
                    </ul>
                    <div class="d-flex gap-2 mt-2">
                        <span class="footer-social"><i class="fab fa-facebook-f"></i></span>
                        <span class="footer-social"><i class="fab fa-instagram"></i></span>
                        <span class="footer-social"><i class="fab fa-youtube"></i></span>
                    </div>
                </div>
            </div>
            <hr style="border-color:rgba(255,255,255,0.1);margin:1.5rem 0 1rem">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);margin:0">&copy; 2026 E-Bazaar. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <span style="font-size:0.72rem;color:rgba(255,255,255,0.35)">🇧🇩 Made in Bangladesh</span>
                </div>
            </div>
        </div>
    </footer>
    <script>
        // Show footer links based on auth state
        (function () {
            if (typeof Common === 'undefined') return;
            if (Common.isLoggedIn()) {
                const role = Common.getUserInfo().role;
                document.getElementById('footer-profile').classList.remove('d-none');
                if (role === 'Admin') {
                    document.getElementById('footer-admin').classList.remove('d-none');
                } else {
                    document.getElementById('footer-orders').classList.remove('d-none');
                }
            }
        })();
    </script>

</body>
</html>