# Local .terraform directories (downloaded providers/modules) - never commit, regenerated by `terraform init`.
**/.terraform/*

# Terraform state - contains resource data and, depending on resources, sensitive values.
*.tfstate
*.tfstate.*

# Saved plan output.
*.tfplan

# Crash logs.
crash.log
crash.*.log

# Auto-loaded variable files are the recommended place for real secrets locally - never commit them.
*.auto.tfvars
*.auto.tfvars.json
secrets.tfvars
secrets.tfvars.json

# CLI config that may contain credentials.
.terraformrc
terraform.rc
